<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="3dp" android:paddingEnd="4dp">
    <ImageView android:layout_width="23dp" android:layout_height="23dp"
        android:layout_marginEnd="6dp" android:importantForAccessibility="no"
        android:src="@drawable/proxy_notification_icon" />
    <LinearLayout android:id="@+id/notification_mode_target"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="2" android:layout_marginEnd="8dp"
        android:gravity="center_vertical" android:orientation="vertical">
        <TextView android:id="@+id/notification_mode" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:includeFontPadding="false" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textStyle="bold" android:textSize="14sp" />
        <TextView android:id="@+id/notification_app" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:layout_marginTop="3dp" android:includeFontPadding="false"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/notification_node_target"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3"
        android:gravity="center_vertical" android:orientation="vertical">
        <TextView android:id="@+id/notification_node" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:includeFontPadding="false" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textStyle="bold" android:textSize="13sp" />
        <TextView android:id="@+id/notification_down" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2" android:textSize="11sp" />
        <TextView android:id="@+id/notification_up" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:maxLines="1" android:includeFontPadding="false"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
